<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only chain seeder for UX testing of the Campaigns screen. Exported so it can be
      triggered from adb; present only in debug builds (src/debug). See DebugSeedReceiver.
        adb shell am broadcast -n com.qalqan.antifraud/.debug.DebugSeedReceiver
    -->
    <application>
        <receiver
            android:name=".debug.DebugSeedReceiver"
            android:exported="true" />

        <!-- Registers DebugHooks before any screen renders so the in-app "Seed demo chains"
             button appears. Debug-only; not exported (no data is served). -->
        <provider
            android:name=".debug.DebugInitProvider"
            android:authorities="${applicationId}.debuginit"
            android:exported="false" />
    </application>
</manifest>
